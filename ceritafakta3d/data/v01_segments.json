 "segments": [
  {
   "line": 0,
   "start": 0.05,
   "end": 1.41,
   "text": "Ada satu haiwan ni,"
  },
  {
   "line": 0,
   "start": 1.68,
   "end": 2.51,
   "text": "jantung dia"
  },
  {
   "line": 0,
