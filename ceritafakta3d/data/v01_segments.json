{
  "note": "Speech segments found with ffmpeg silencedetect (noise=-38dB, d=0.12s) on public/audio/v01_sotong_kurita.wav, each mapped to its exact voiceover text. 'line' = index (0-based) of the caption line in v01_captions.json. Used by scripts/make-words.mjs when whisper is unavailable.",
  "duration": 57.51,
  "segments": [
    {"line": 0, "start": 0.25, "end": 1.35, "text": "Ada satu haiwan ni,"},
    {"line": 0, "start": 1.51, "end": 2.40, "text": "jantung dia tiga."},
    {"line": 1, "start": 2.74, "end": 3.55, "text": "Darah dia pulak..."},
    {"line": 2, "start": 4.02, "end": 4.82, "text": "warna biru."},
    {"line": 3, "start": 5.27, "end": 7.07, "text": "Haiwan tu ialah sotong kurita."},
    {"line": 4, "start": 7.29, "end": 8.80, "text": "Dua jantung kecil"},
    {"line": 4, "start": 9.20, "end": 10.34, "text": "kerja pam darah ke insang,"},
    {"line": 5, "start": 10.79, "end": 12.07, "text": "tempat dia ambil oksigen."},
    {"line": 6, "start": 12.43, "end": 13.58, "text": "Satu jantung lagi"},
    {"line": 6, "start": 13.99, "end": 15.46, "text": "pam darah ke seluruh badan."},
    {"line": 7, "start": 15.95, "end": 16.70, "text": "Yang peliknya,"},
    {"line": 8, "start": 17.19, "end": 18.74, "text": "bila sotong kurita berenang,"},
    {"line": 9, "start": 18.99, "end": 19.98, "text": "jantung badan tu"},
    {"line": 9, "start": 20.24, "end": 21.12, "text": "berhenti berdegup."},
    {"line": 10, "start": 21.52, "end": 22.18, "text": "Sebab tu"},
    {"line": 10, "start": 22.48, "end": 24.85, "text": "dia lagi suka merangkak atas dasar laut."},
    {"line": 11, "start": 25.17, "end": 26.91, "text": "Berenang buat dia cepat penat."},
    {"line": 12, "start": 27.36, "end": 28.38, "text": "Darah kita merah"},
    {"line": 12, "start": 28.66, "end": 29.94, "text": "sebab ada zat besi."},
    {"line": 13, "start": 30.23, "end": 32.12, "text": "Darah sotong kurita guna tembaga."},
    {"line": 14, "start": 32.49, "end": 34.14, "text": "Bahan tu namanya hemosianin,"},
    {"line": 15, "start": 34.47, "end": 35.59, "text": "dan dia jadi biru"},
    {"line": 15, "start": 35.86, "end": 36.93, "text": "bila bawa oksigen."},
    {"line": 16, "start": 37.29, "end": 38.10, "text": "Satu lagi:"},
    {"line": 17, "start": 38.42, "end": 40.28, "text": "lebih kurang dua pertiga sel saraf"},
    {"line": 17, "start": 40.77, "end": 41.70, "text": "dia ada dalam lengan,"},
    {"line": 18, "start": 42.08, "end": 43.13, "text": "bukan dalam kepala."},
    {"line": 19, "start": 43.46, "end": 44.07, "text": "Sebab tu"},
    {"line": 19, "start": 44.34, "end": 46.49, "text": "setiap lengan boleh fikir sendiri."},
    {"line": 20, "start": 46.76, "end": 47.65, "text": "Tiga jantung,"},
    {"line": 20, "start": 48.08, "end": 48.79, "text": "darah biru,"},
    {"line": 20, "start": 49.29, "end": 50.50, "text": "lengan yang boleh fikir."},
    {"line": 21, "start": 50.70, "end": 51.99, "text": "Rasa macam alien, kan?"},
    {"line": 22, "start": 52.31, "end": 53.49, "text": "Follow akaun aku,"},
    {"line": 23, "start": 53.85, "end": 57.34, "text": "esok aku cerita kenapa kau tak boleh geletek diri sendiri."}
  ]
}
