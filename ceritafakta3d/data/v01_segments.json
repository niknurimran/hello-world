  },
  {
   "line": 1,
   "start": 3.66,
   "end": 4.82,
   "text": "Darah dia pulak..."
  },
  {
   "line": 2,
   "start": 5.12,
   "end": 5.88,
   "text": "warna biru."
  },
  {
   "line": 3,
   "start": 6.38,
   "end": 7.78,
   "text": "Haiwan tu ialah"
  },
  {
   "line": 3,
   "start": 7.92,
   "end": 8.73,
   "text": "sotong kurita."
  },
  {
   "line": 4,
   "start": 9.23,
   "end": 10.79,
   "text": "Dua jantung kecil"
  },
  {
   "line": 4,
   "start": 10.93,
   "end": 12.23,
   "text": "kerja pam darah ke insang,"
  },
  {
   "line": 5,
   "start": 12.48,
   "end": 13.74,
   "text": "tempat dia ambil oksigen."
  },
  {
   "line": 6,
   "start": 14.2,
   "end": 15.38,
   "text": "Satu jantung lagi"
  },
  {
   "line": 6,
   "start": 15.55,
   "end": 17.44,
   "text": "pam darah ke seluruh badan."
  },
  {
   "line": 7,
   "start": 17.95,
   "end": 18.9,
   "text": "Yang peliknya,"
  },
  {
   "line": 8,
   "start": 19.15,
   "end": 20.75,
   "text": "bila sotong kurita berenang,"
  },
  {
   "line": 9,
   "start": 21.08,
   "end": 23.16,
   "text": "jantung badan tu berhenti berdegup."
  },
  {
   "line": 10,
   "start": 23.66,
   "end": 23.92,
   "text": "Sebab tu"
  },
  {
   "line": 10,
   "start": 24.07,
   "end": 26.59,
   "text": "dia lagi suka merangkak atas dasar laut."
  },
  {
   "line": 11,
   "start": 27.03,
   "end": 28.82,
   "text": "Berenang buat dia cepat penat."
  },
  {
   "line": 12,
   "start": 29.32,
   "end": 31.98,
   "text": "Darah kita merah sebab ada zat besi."
  },
  {
   "line": 13,
   "start": 32.47,
   "end": 34.81,
   "text": "Darah sotong kurita guna tembaga."
  },
  {
   "line": 14,
   "start": 35.26,
   "end": 37.6,
   "text": "Bahan tu namanya hemosianin,"
  },
  {
   "line": 15,
   "start": 37.99,
   "end": 40.33,
   "text": "dan dia jadi biru bila bawa oksigen."
  },
  {
   "line": 16,
   "start": 40.84,
   "end": 41.48,
   "text": "Satu lagi:"
  },
  {
   "line": 17,
   "start": 41.92,
   "end": 45.51,
   "text": "lebih kurang dua pertiga sel saraf dia ada dalam lengan,"
  },
  {
   "line": 18,
   "start": 45.69,
   "end": 46.9,
   "text": "bukan dalam kepala."
  },
  {
   "line": 19,
   "start": 47.34,
   "end": 47.59,
   "text": "Sebab tu"
  },
  {
   "line": 19,
   "start": 47.73,
   "end": 49.58,
   "text": "setiap lengan boleh fikir sendiri."
  },
  {
   "line": 20,
   "start": 49.78,
   "end": 50.86,
   "text": "Tiga jantung,"
  },
  {
   "line": 20,
   "start": 51.36,
   "end": 52.44,
   "text": "darah biru,"
  },
  {
   "line": 20,
   "start": 52.59,
   "end": 53.57,
   "text": "lengan yang boleh fikir."
  },
  {
   "line": 21,
   "start": 53.72,
   "end": 54.98,
   "text": "Rasa macam alien, kan?"
  },
  {
   "line": 22,
   "start": 55.44,
   "end": 56.84,
   "text": "Follow akaun aku,"
  },
  {
   "line": 23,
