 "duration": 48.93,
 "segments": [
  {
   "line": 0,
   "start": 0.05,
   "end": 1.75,
   "text": "Cuba geletek diri sendiri sekarang."
  },
  {
   "line": 1,
   "start": 2.23,
   "end": 3.11,
   "text": "Tak geli, kan?"
  },
  {
   "line": 2,
   "start": 3.64,
   "end": 5.27,
   "text": "Tapi kalau orang lain buat,"
  },
  {
   "line": 2,
   "start": 5.53,
   "end": 6.83,
   "text": "kau terus menggelupur."
  },
  {
   "line": 3,
   "start": 7.37,
   "end": 9.78,
   "text": "Rahsia dia ada kat bahagian belakang otak,"
  },
  {
   "line": 4,
   "start": 9.9,
   "end": 11.81,
   "text": "namanya serebelum."
  },
  {
   "line": 5,
   "start": 12.34,
   "end": 13.87,
   "text": "Setiap kali kau gerak tangan,"
  },
  {
   "line": 6,
   "start": 14.04,
   "end": 15.94,
   "text": "serebelum dah ramal dulu"
  },
  {
   "line": 6,
   "start": 16.14,
   "end": 17.16,
   "text": "apa yang kau akan rasa."
  },
  {
   "line": 7,
   "start": 17.69,
   "end": 18.66,
   "text": "Bila ramalan tu tepat,"
  },
  {
   "line": 7,
   "start": 18.8,
   "end": 21.14,
   "text": "otak terus kecilkan rasa tu."
  },
  {
   "line": 8,
   "start": 21.54,
   "end": 22.02,
   "text": "Dia anggap:"
  },
  {
   "line": 8,
   "start": 22.42,
   "end": 23.37,
   "text": "“Ni aku sendiri,"
  },
  {
   "line": 8,
   "start": 23.54,
   "end": 24.27,
   "text": "tak payah risau.”"
  },
  {
   "line": 9,
   "start": 24.73,
   "end": 26.07,
   "text": "Geli sebenarnya"
  },
  {
   "line": 9,
   "start": 26.23,
   "end": 27.3,
   "text": "datang dari kejutan."
  },
  {
   "line": 10,
   "start": 27.78,
   "end": 28.71,
   "text": "Bila orang lain geletek,"
  },
  {
   "line": 11,
   "start": 28.84,
   "end": 32.77,
   "text": "otak tak tahu bila dan kat mana sentuhan tu datang."
  },
  {
   "line": 12,
   "start": 33.31,
   "end": 34.5,
   "text": "Sistem ni penting."
  },
  {
   "line": 13,
   "start": 34.93,
   "end": 35.45,
   "text": "Kalau tak,"
  },
  {
   "line": 13,
   "start": 35.63,
   "end": 37.44,
   "text": "setiap kali baju kau bergesel,"
  },
  {
   "line": 14,
   "start": 37.65,
   "end": 39.25,
   "text": "kau rasa macam ada orang sentuh."
  },
  {
   "line": 15,
   "start": 39.8,
   "end": 41.25,
   "text": "Jadi kalau ada orang kata"
  },
  {
   "line": 15,
   "start": 41.37,
   "end": 42.27,
   "text": "dia boleh geletek"
  },
  {
   "line": 15,
   "start": 42.43,
   "end": 43.4,
   "text": "diri sendiri,"
  },
  {
   "line": 16,
   "start": 43.8,
   "end": 45.71,
   "text": "mungkin otak dia lain sikit."
  },
  {
   "line": 17,
   "start": 46.26,
   "end": 47.26,
   "text": "Tag kawan kau"
  },
  {
   "line": 17,
   "start": 47.41,
   "end": 48.74,
   "text": "yang paling tak tahan geli."
  }
 ]
