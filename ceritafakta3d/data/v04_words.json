 "lines": [
  {
   "text": "Ahli arkeologi pernah jumpa balang madu",
   "start": 0.05,
   "end": 2.86
  },
  {
   "text": "dalam makam Mesir purba.",
   "start": 2.86,
   "end": 4.6
  },
  {
   "text": "Umur dia beribu tahun.",
   "start": 5.08,
   "end": 6.94
  },
  {
   "text": "Dan madu tu masih belum basi.",
   "start": 7.38,
   "end": 9.45
  },
  {
   "text": "Sebab pertama, madu sangat kurang air.",
   "start": 9.88,
   "end": 13.02
  },
  {
   "text": "Bakteria perlukan air untuk hidup,",
   "start": 13.45,
   "end": 15.42
  },
  {
   "text": "jadi dalam madu dia “kering” dan mati.",
   "start": 15.78,
   "end": 18.8
  },
  {
   "text": "Sebab kedua, madu sebenarnya berasid.",
   "start": 19.31,
   "end": 22.41
  },
  {
   "text": "Bakteria tak suka tempat masam.",
   "start": 22.87,
   "end": 25.16
  },
  {
   "text": "Sebab ketiga, lebah tambah enzim dalam madu.",
   "start": 25.65,
   "end": 29.09
  },
  {
   "text": "Enzim ni hasilkan sedikit hidrogen peroksida,",
   "start": 29.55,
   "end": 32.83
  },
  {
   "text": "sejenis bahan pembunuh kuman semula jadi.",
   "start": 33.17,
   "end": 35.83
  },
  {
   "text": "Tapi ada syarat: tutup balang rapat-rapat.",
   "start": 36.26,
   "end": 39.71
  },
  {
   "text": "Kalau madu serap air dari udara, dia boleh rosak.",
   "start": 40.23,
   "end": 43.43
  },
  {
   "text": "Kalau madu kau berketul atau berkristal, itu normal.",
   "start": 43.85,
   "end": 47.46
  },
  {
   "text": "Rendam balang dalam air suam, nanti dia cair balik.",
   "start": 47.95,
   "end": 50.72
  },
  {
   "text": "Makanan yang boleh tahan lebih lama dari tamadun.",
   "start": 51.2,
   "end": 54.25
  },
  {
   "text": "Esok: kau tengok matahari,",
   "start": 54.89,
   "end": 56.91
  },
  {
   "text": "tapi sebenarnya kau tengok masa lalu.",
   "start": 57.38,
   "end": 60.1
  }
 ],
