 "duration": 48.93,
 "lines": [
  {
   "text": "Cuba geletek diri sendiri sekarang.",
   "start": 0.05,
   "end": 1.75
  },
  {
   "text": "Tak geli, kan?",
   "start": 2.23,
   "end": 3.11
  },
  {
   "text": "Tapi kalau orang lain buat, kau terus menggelupur.",
   "start": 3.64,
   "end": 6.83
  },
  {
   "text": "Rahsia dia ada kat bahagian belakang otak,",
   "start": 7.37,
   "end": 9.78
  },
  {
   "text": "namanya serebelum.",
   "start": 9.9,
   "end": 11.81
  },
  {
   "text": "Setiap kali kau gerak tangan,",
   "start": 12.34,
   "end": 13.87
  },
  {
   "text": "serebelum dah ramal dulu apa yang kau akan rasa.",
   "start": 14.04,
   "end": 17.16
  },
  {
   "text": "Bila ramalan tu tepat, otak terus kecilkan rasa tu.",
   "start": 17.69,
   "end": 21.14
  },
  {
   "text": "Dia anggap: “Ni aku sendiri, tak payah risau.”",
   "start": 21.54,
   "end": 24.27
  },
  {
   "text": "Geli sebenarnya datang dari kejutan.",
   "start": 24.73,
   "end": 27.3
  },
  {
   "text": "Bila orang lain geletek,",
   "start": 27.78,
   "end": 28.71
  },
  {
   "text": "otak tak tahu bila dan kat mana sentuhan tu datang.",
   "start": 28.84,
   "end": 32.77
  },
  {
   "text": "Sistem ni penting.",
   "start": 33.31,
   "end": 34.5
  },
  {
   "text": "Kalau tak, setiap kali baju kau bergesel,",
   "start": 34.93,
   "end": 37.44
  },
  {
   "text": "kau rasa macam ada orang sentuh.",
   "start": 37.65,
   "end": 39.25
  },
  {
   "text": "Jadi kalau ada orang kata dia boleh geletek diri sendiri,",
   "start": 39.8,
   "end": 43.4
  },
  {
   "text": "mungkin otak dia lain sikit.",
   "start": 43.8,
   "end": 45.71
  },
  {
   "text": "Tag kawan kau yang paling tak tahan geli.",
   "start": 46.26,
   "end": 48.74
  }
 ],
