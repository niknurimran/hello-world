{
 "source": "segments+char-length",
 "duration": 57.51,
 "lines": [
  {
   "text": "Ada satu haiwan ni, jantung dia tiga.",
   "start": 0.25,
   "end": 2.4
  },
  {
   "text": "Darah dia pulak...",
   "start": 2.74,
   "end": 3.55
  },
  {
   "text": "warna biru.",
   "start": 4.02,
   "end": 4.82
  },
  {
   "text": "Haiwan tu ialah sotong kurita.",
   "start": 5.27,
   "end": 7.07
  },
  {
   "text": "Dua jantung kecil kerja pam darah ke insang,",
   "start": 7.29,
   "end": 10.34
  },
  {
   "text": "tempat dia ambil oksigen.",
   "start": 10.79,
   "end": 12.07
  },
  {
   "text": "Satu jantung lagi pam darah ke seluruh badan.",
   "start": 12.43,
   "end": 15.46
  },
  {
   "text": "Yang peliknya,",
   "start": 15.95,
   "end": 16.7
  },
  {
   "text": "bila sotong kurita berenang,",
   "start": 17.19,
   "end": 18.74
  },
  {
   "text": "jantung badan tu berhenti berdegup.",
   "start": 18.99,
   "end": 21.12
  },
  {
   "text": "Sebab tu dia lagi suka merangkak atas dasar laut.",
   "start": 21.52,
   "end": 24.85
  },
  {
   "text": "Berenang buat dia cepat penat.",
   "start": 25.17,
   "end": 26.91
  },
  {
   "text": "Darah kita merah sebab ada zat besi.",
   "start": 27.36,
   "end": 29.94
  },
  {
   "text": "Darah sotong kurita guna tembaga.",
   "start": 30.23,
   "end": 32.12
  },
  {
   "text": "Bahan tu namanya hemosianin,",
   "start": 32.49,
   "end": 34.14
  },
  {
   "text": "dan dia jadi biru bila bawa oksigen.",
   "start": 34.47,
   "end": 36.93
  },
  {
   "text": "Satu lagi:",
   "start": 37.29,
   "end": 38.1
  },
  {
   "text": "lebih kurang dua pertiga sel saraf dia ada dalam lengan,",
   "start": 38.42,
   "end": 41.7
  },
  {
   "text": "bukan dalam kepala.",
   "start": 42.08,
   "end": 43.13
  },
  {
   "text": "Sebab tu setiap lengan boleh fikir sendiri.",
   "start": 43.46,
   "end": 46.49
  },
  {
   "text": "Tiga jantung, darah biru, lengan yang boleh fikir.",
   "start": 46.76,
   "end": 50.5
  },
  {
   "text": "Rasa macam alien, kan?",
   "start": 50.7,
   "end": 51.99
  },
  {
   "text": "Follow akaun aku,",
   "start": 52.31,
   "end": 53.49
  },
  {
   "text": "esok aku cerita kenapa kau tak boleh geletek diri sendiri.",
   "start": 53.85,
   "end": 57.34
  }
 ],
